  npcName: Aeacus
  npcPortrait: {fileID: -1067800199436942952, guid: 4f54932a727e6be4b9b3f165c91bf54e,
    type: 3}
  dialogueLines:
  - "Hey! You're the new soul, right? Name's Aeacus. Don't let the <color=orange>stairs</color>
    fool you\u2014they're not just stone."
  - "That door's <color=orange>sealed tight</color>. Fortuna's way of testing us.
    See, the statues don't just give coins and food\u2026 sometimes they drop <color=orange>keys</color>. "
  - Bronze keys open bronze doors. Simple, right? Keep offering at the statue until
    a bronze key falls into your hands.
  - One key, one door. That's how we go deeper. Get a <color=orange>bronze key</color>,
    and explore what's waiting above.
  - May Fortuna bless you.
  - I like the spirit!
  typingSpeed: 0.05
