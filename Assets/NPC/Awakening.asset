  m_Script: {fileID: 11500000, guid: 18e4e8631d5933b4c8b839d0b4e078f5, type: 3}
  m_Name: Awakening
  m_EditorClassIdentifier: Assembly-CSharp::NPCdialogue
  npcName: Voice in my head
  npcPortrait: {fileID: 4723107735738678597, guid: 8fb714981d0793048bf4512c21217f9b,
    type: 3}
  dialogueLines:
  - '"You are a reincarnated soul, drawn to the Village of Fortuna."'
  - "\"The statues don't grant luck\u2014they redistribute fate.\""
  - '"Your journey through the tiers isn''t just progression."'
  - '"It''s you remembering who you were."'
  - '"Understanding what the echoes sacrificed."'
  - '"And deciding what kind of vessel you''ll become."'
  - '"Your breath steadies. The village wakes. Find the Priest by the central statue."'
